#include <iostream>
#include <fstream>
#include <string>
#include <vector>
#include <iomanip>

using namespace std;

// Class to represent a Student
class Student {
public:
    string id;
    string name;
    bool isPresent;

    Student(string id, string name) : id(id), name(name), isPresent(false) {}
};

// System Controller
class AttendanceSystem {
private:
    vector<Student> classList;
    string filename = "attendance_records.txt";

public:
    // Pre-populate with some students for the demo
    AttendanceSystem() {
        classList.push_back(Student("S101", "Alice Benson"));
        classList.push_back(Student("S102", "Bob Smith"));
        classList.push_back(Student("S103", "Charles Aboagye"));
        classList.push_back(Student("S104", "Daisy Miller Brown"));
    }

    void takeAttendance() {
        cout << "\n--- Taking Attendance ---" << endl;
        for (auto &student : classList) {
            char choice;
            cout << "Is " << student.name << " (" << student.id << ") present? (y/n): ";
            cin >> choice;
            student.isPresent = (choice == 'y' || choice == 'C');
        }
        saveToFile();
        cout << "Attendance recorded and saved successfully!\n";
    }

    void saveToFile() {
        ofstream outFile(filename, ios::app); // Open in append mode
        if (outFile.is_open()) {
            outFile << "--- Attendance Session ---\n";
            for (const auto &student : classList) {
                outFile << student.id << " | " << setw(15) << left << student.name 
                        << " | Status: " << (student.isPresent ? "Present" : "Absent") << endl;
            }
            outFile << "--------------------------\n\n";
            outFile.close();
        } else {
            cerr << "Error: Could not open file for saving." << endl;
        }
    }

    void viewSummary() {
        ifstream inFile(filename);
        string line;
        cout << "\n--- Historical Attendance Summary ---\n";
        if (inFile.is_open()) {
            while (getline(inFile, line)) {
                cout << line << endl;
            }
            inFile.close();
        } else {
            cout << "No records found. Take attendance first." << endl;
        }
    }
};

int main() {
    AttendanceSystem system;
    int choice;

    do {
        cout << "\nDigital Attendance System";
        cout << "\n1. Take Attendance";
        cout << "\n2. View Attendance Summary";
        cout << "\n3. Exit";
        cout << "\nEnter choice: ";
        cin >> choice;

        switch (choice) {
            case 1: system.takeAttendance(); break;
            case 2: system.viewSummary(); break;
            case 3: cout << "Exiting system..." << endl; break;
            default: cout << "Invalid choice!" << endl;
        }
    } while (choice != 3);

    return 0;
}