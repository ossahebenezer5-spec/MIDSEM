#include <iostream>
#include <vector>
#include <string>
using namespace std;

class Student {
public:
    string name;
    int id;
    int attendanceCount;

    Student(string n, int i) {
        name = n;
        id = i;
        attendanceCount = 0;
    }
};

class AttendanceSystem {
private:
    vector<Student> students;

public:
    void addStudent() {
        string name;
        int id;

        cout << "Enter Student Name: ";
        cin.ignore();
        getline(cin, name);

        cout << "Enter Student ID: ";
        cin >> id;

        students.push_back(Student(name, id));
        cout << "Student added successfully!\n";
    }

    void markAttendance() {
        int id;
        cout << "Enter Student ID to mark attendance: ";
        cin >> id;

        for (auto &student : students) {
            if (student.id == id) {
                student.attendanceCount++;
                cout << "Attendance marked for " << student.name << endl;
                return;
            }
        }

        cout << "Student not found!\n";
    }

    void viewStudents() {
        cout << "\n--- Student List ---\n";
        for (auto student : students) {
            cout << "Name: " << student.name
                 << ", ID: " << student.id
                 << ", Attendance: " << student.attendanceCount << endl;
        }
    }

    void attendanceSummary() {
        cout << "\n--- Attendance Summary ---\n";
        for (auto student : students) {
            cout << student.name << " attended "
                 << student.attendanceCount << " classes.\n";
        }
    }
};

int main() {
    AttendanceSystem system;
    int choice;

    do {
        cout << "\n===== DIGITAL ATTENDANCE SYSTEM =====\n";
        cout << "1. Add Student\n";
        cout << "2. Mark Attendance\n";
        cout << "3. View Students\n";
        cout << "4. Attendance Summary\n";
        cout << "5. Exit\n";
        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice) {
        case 1:
            system.addStudent();
            break;
        case 2:
            system.markAttendance();
            break;
        case 3:
            system.viewStudents();
            break;
        case 4:
            system.attendanceSummary();
            break;
        case 5:
            cout << "Exiting system...\n";
            break;
        default:
            cout << "Invalid choice!\n";
        }

    } while (choice != 5);

    return 0;
}