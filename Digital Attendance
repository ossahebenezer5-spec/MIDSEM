#include <iostream>
#include <fstream>
#include <string>
#include <vector>
#include <iomanip>
#include <ctime> // For timestamping records

using namespace std;

// Class to represent a Student
class Student {
public:
    string id;
    string name;
    bool isPresent;

    Student(string id, string name) : id(id), name(name), isPresent(false) {}
};

// System Controller
class AttendanceSystem {
private:
    vector<Student> classList;
    string filename = "attendance_records.txt";

    // Helper function to get current date/time as a string
    string getCurrentTimestamp() {
        time_t now = time(0);
        char buf[80];
        struct tm tstruct = *localtime(&now);
        strftime(buf, sizeof(buf), "%Y-%m-%d %X", &tstruct);
        return string(buf);
    }

public:
    AttendanceSystem() {
        // Pre-populating class list as per assignment scope
        classList.push_back(Student("S101", "Kofi Manu"));
        classList.push_back(Student("S102", "Bobby Brown"));
        classList.push_back(Student("S103", "Charles Osei"));
        classList.push_back(Student("S104", "Mike Owusu"));
    }

    void takeAttendance() {
        cout << "\n--- Attendance Session: " << getCurrentTimestamp() << " ---" << endl;
        
        for (auto &student : classList) {
            char choice;
            bool valid = false;

            while (!valid) {
                cout << "Is " << student.name << " (" << student.id << ") present? (y/n): ";
                cin >> choice;

                if (tolower(choice) == 'y' || tolower(choice) == 'n') {
                    student.isPresent = (tolower(choice) == 'y');
                    valid = true;
                } else {
                    cout << "Invalid input. Please enter 'y' for present or 'n' for absent." << endl;
                }
                
                // Clear the buffer to prevent "ghost" inputs if user types "yes"
                cin.ignore(1000, '\n');
            }
        }
        saveToFile();
        cout << "\nAttendance recorded and saved to " << filename << endl;
    }

    void saveToFile() {
        ofstream outFile(filename, ios::app); 
        if (outFile.is_open()) {
            outFile << "Session Date/Time: " << getCurrentTimestamp() << "\n";
            outFile << "--------------------------------------------------\n";
            outFile << left << setw(10) << "ID" << setw(20) << "Name" << "Status\n";
            outFile << "--------------------------------------------------\n";
            
            for (const auto &student : classList) {
                outFile << left << setw(10) << student.id 
                        << setw(20) << student.name 
                        << (student.isPresent ? "Present" : "Absent") << endl;
            }
            outFile << "--------------------------------------------------\n\n";
            outFile.close();
        } else {
            cerr << "Critical Error: Could not open record file." << endl;
        }
    }

    void viewSummary() {
        ifstream inFile(filename);
        string line;
        cout << "\n--- Historical Attendance Records ---\n";
        if (inFile.is_open()) {
            while (getline(inFile, line)) {
                cout << line << endl;
            }
            inFile.close();
        } else {
            cout << "No records found. Please conduct a session first." << endl;
        }
    }
};

int main() {
    AttendanceSystem system;
    int choice;

    while (true) {
        cout << "\n===============================";
        cout << "\n   DIGITAL ATTENDANCE SYSTEM";
        cout << "\n===============================";
        cout << "\n1. Take New Attendance";
        cout << "\n2. View All Saved Summaries";
        cout << "\n3. Exit System";
        cout << "\nChoose an option: ";

        if (!(cin >> choice)) {
            cout << "Invalid input! Please enter a number (1-3)." << endl;
            cin.clear();
            cin.ignore(1000, '\n');
            continue;
        }

        if (choice == 1) {
            system.takeAttendance();
        } else if (choice == 2) {
            system.viewSummary();
        } else if (choice == 3) {
            cout << "System shutting down. Goodbye!" << endl;
            break;
        } else {
            cout << "Selection out of range." << endl;
        }
    }

    return 0;
}
